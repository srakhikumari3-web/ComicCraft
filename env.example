# Required for real AI generation
GEMINI_API_KEY=your_google_gemini_api_key
HF_API_KEY=your_huggingface_token

# Current defaults; change if your account has different model access
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Image backend: hf, local_diffusers, or demo
IMAGE_BACKEND=hf
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
LOCAL_IMAGE_MODEL=runwayml/stable-diffusion-v1-5
IMAGE_WIDTH=768
IMAGE_HEIGHT=512
IMAGE_STEPS=20

# Set true to run without API keys using local demo content/images
DEMO_MODE=false
